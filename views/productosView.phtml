<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Productos</title>
        <link rel="stylesheet" href="css/styles.css">
    </head>
    <body>
        <nav>
            <h1>Productos</h1>
            <?php if (($_SESSION['user_rol'] ?? '') === 'admin'): ?>
                <a href="index.php?action=productos&new=1"><button>Nuevo Producto</button></a>
            <?php endif; ?>
            <a href="index.php?action=index"><button>Volver</button></a>
            <?php if (($_SESSION['user_rol'] ?? '') === 'admin'): ?>
                <a href="index.php?action=panel"><button>Panel de Control</button></a>
            <?php endif; ?>
            <a href="index.php?c=order&show=1" class="nav-right"><button>Ver Carrito</button></a>
        </nav>
        <div class="categorias">
            <a href="index.php?action=productos" class="<?= $categoria === null ? 'activa' : '' ?>"><button>Ver todo</button></a>
            <?php foreach (Producto::CATEGORIAS as $clave => $nombre): ?>
                <a href="index.php?action=productos&categoria=<?= $clave ?>" class="<?= $categoria === $clave ? 'activa' : '' ?>"><button><?= $nombre ?></button></a>
            <?php endforeach; ?>
        </div>
        <h2><?= $categoria ? Producto::CATEGORIAS[$categoria] : 'Todos los productos' ?></h2>
        <?php if (empty($products)): ?>
            <p>No hay productos en esta categoría.</p>
        <?php endif; ?>
        <?php foreach ($products as $product): ?>
            <div>
                <h3><?= htmlspecialchars($product['nombre']) ?></h3>
                <p><?= htmlspecialchars($product['descripcion']) ?></p>
                <p>Precio: <?= htmlspecialchars($product['precio']) ?>€</p>
                <p>Stock: <?= htmlspecialchars($product['stock']) ?></p>
                <a href="index.php?action=ver&id=<?= $product['id'] ?>"><button type="button" style="background: #5f6368; margin-bottom: 8px;">Ver Detalle</button></a>
                <?php if (($_SESSION['user_rol'] ?? '') === 'admin'): ?>
                    <a href="index.php?action=productos&edit=1&id=<?= $product['id'] ?>"><button type="button" style="background: #188038; margin-bottom: 8px;">Editar</button></a>
                    <a href="index.php?action=productos&delete=<?= $product['id'] ?>" onclick="return confirm('¿Seguro que quieres eliminar este producto?');"><button type="button" style="background: #d93025; margin-bottom: 8px;">Eliminar</button></a>
                <?php endif; ?>
                <form action="index.php?c=order&add=1" method="POST" style="margin-top: 10px;">
                    <input type="hidden" name="id" value="<?= $product['id'] ?>">
                    <label for="qty_<?= $product['id'] ?>">Cantidad:</label>
                    <input type="number" id="qty_<?= $product['id'] ?>" name="quantity" value="1" min="1" max="<?= $product['stock'] ?>" style="width: 80px;">
                    <button type="submit">Añadir al carrito</button>
                </form>
            </div>
        <?php endforeach; ?>
    </body>
</html>
