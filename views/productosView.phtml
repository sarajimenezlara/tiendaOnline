<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Productos</title>
    </head>
    <body>
        <h1>Productos</h1>
        <p><a href="index.php">Inicio</a></p>
        <?php if (!empty($dbError)): ?>
            <p style="color:red;">Error BD: <?= htmlspecialchars($dbError) ?></p>
        <?php endif; ?>
        <?php if (empty($products)): ?>
            <p>No hay productos.</p>
        <?php else: ?>
            <ul>
            <?php foreach ($products as $p): ?>
                <li>
                    <a href="index.php?action=ver&id=<?= (int)$p->getId() ?>"><?= htmlspecialchars($p->getNombre()) ?></a>
                    - <?= htmlspecialchars($p->getCategoria()) ?>
                    - <?= number_format($p->getPrecio(), 2) ?> €
                </li>
            <?php endforeach; ?>
            </ul>
        <?php endif; ?>
    </body>
</html>
