    <form action="index.php?action=productos&update=1" method="POST">
        <input type="hidden" name="id" value="<?= (int)($product['id'] ?? 0) ?>">

        <label for="name">Nombre:</label>
        <input type="text" name="name" id="name" value="<?= htmlspecialchars($_POST['name'] ?? ($product['nombre'] ?? '')) ?>" required>

