        <input type="number" name="stock" id="stock" min="0" value="<?= htmlspecialchars($_POST['stock'] ?? ($product['stock'] ?? '')) ?>" required>

        <label for="price">Precio:</label>
        <input type="number" name="price" id="price" step="0.01" min="0" value="<?= htmlspecialchars($_POST['price'] ?? ($product['precio'] ?? '')) ?>" required>

