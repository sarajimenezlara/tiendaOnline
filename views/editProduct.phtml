        <select name="categoria" id="categoria" required>
            <?php foreach (Producto::CATEGORIAS as $clave => $nombre): ?>
                <option value="<?= $clave ?>" <?= $catSel === $clave ? 'selected' : '' ?>><?= $nombre ?></option>
            <?php endforeach; ?>
        </select>

        <label for="description">Descripción:</label>
        <textarea name="description" id="description" required><?= htmlspecialchars($_POST['description'] ?? ($product['descripcion'] ?? '')) ?></textarea>

